{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wyrlex:corpus:target:v1",
  "type": "object",
  "required": [
    "schema_version",
    "target_id",
    "family",
    "identity"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "family": {
      "enum": [
        "linux",
        "mikrotik",
        "zte",
        "huawei",
        "vsol"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "vendor",
        "model",
        "architecture",
        "software",
        "tools"
      ],
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "software": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "component",
              "version",
              "sha256"
            ],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "tools": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
